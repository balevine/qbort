{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // The tests are TypeScript but their subject is dependency-free `.mjs`, so TS has to be allowed
    // to read it. `checkJs` stays off: `plugin/lib` ships without a build step and its types are
    // hand-written JSDoc, so a wrong annotation degrades to `any` here rather than failing the build.
    "allowJs": true,
    "checkJs": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["plugin/lib/*"]
    }
  },
  "include": ["test/**/*.ts", "plugin/lib/**/*.mjs"]
}
